# --- Application Settings ---
PROJECT_NAME=sandbox-agent
VERSION="0.1.0"
DEBUG=true

# [MANDATORY] Path to the main agent configuration file
AEGRA_CONFIG=aegra.json

# --- Database ---
# Option 1: Single connection string (standard for containers/cloud)
# DATABASE_URL=postgresql://user:password@host:5432/sandbox-agent
#
# Option 2: Individual fields (used when DATABASE_URL is not set)
POSTGRES_DB=sandbox-agent
POSTGRES_HOST=localhost
POSTGRES_PASSWORD=sandbox_agent_secret
POSTGRES_PORT=5432
POSTGRES_USER=sandbox_agent
DB_ECHO_LOG=false

# --- Connection Pools ---
# SQLAlchemy (Metadata & App)
SQLALCHEMY_POOL_SIZE=2
SQLALCHEMY_MAX_OVERFLOW=0

# LangGraph (Agent Runtime)
LANGGRAPH_MIN_POOL_SIZE=1
LANGGRAPH_MAX_POOL_SIZE=6

# --- Authentication ---
AUTH_TYPE=noop  # noop, custom
# Access token validity in minutes (default 43200 = 30 days)
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=43200

# --- Server Configuration ---
HOST=0.0.0.0
PORT=8000
SERVER_URL=http://localhost:8000

# --- Logging ---
LOG_LEVEL=INFO
ENV_MODE=LOCAL # DEVELOPMENT, PRODUCTION, LOCAL (PRODUCTION outputs JSON logs)
LOG_VERBOSITY=standard # standard, verbose (verbose outputs request-id)

# --- LLM Providers ---
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...
# TOGETHER_API_KEY=...

# --- Observability (OpenTelemetry) ---
# Unified config for tracing. Supports multiple targets via Fan-out.
OTEL_SERVICE_NAME=aegra-backend
# Enable targets by comma-separated list: "LANGFUSE,PHOENIX,GENERIC"
# Leave empty to disable tracing.
OTEL_TARGETS=""
# Enable debug tracing to console (stdout)
OTEL_CONSOLE_EXPORT=false

# [Target: Langfuse]
# Note: uses LANGFUSE_BASE_URL (not LANGFUSE_HOST) to match SDK standards.
# If Langfuse runs on the Docker host, use http://host.docker.internal:3000.
# If Langfuse runs in another container, use that service name instead of localhost.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-...
LANGFUSE_SECRET_KEY=sk-...

# [Target: Arize Phoenix]
# Default local endpoint shown
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_API_KEY=

# [Target: Generic OTLP]
# For Jaeger, Honeycomb, or other OTLP collectors
OTEL_EXPORTER_OTLP_ENDPOINT=
# Example headers: "Authorization=Bearer <token>,X-Custom=Value"
OTEL_EXPORTER_OTLP_HEADERS=
# Host Docker socket group id for Docker-backed sandboxes when running sandbox-agent in Docker.
DOCKER_GID=998
# Docker user for the aegra service. Keep 0:0 on macOS/Docker Desktop; on Linux you
# can switch to app after confirming the socket group is writable by DOCKER_GID.
AEGRA_DOCKER_USER=0:0
# Delay (seconds) before stopping sandbox container after a dialogue ends.
# Set to 0 to stop immediately.
SANDBOX_AGENT_CONTAINER_STOP_DELAY_SECONDS=1800

# Git diff API payload limit in characters for /sandbox/threads/{id}/git/* endpoints.
# Set to 0 to return full diff content without truncation.
SANDBOX_AGENT_GIT_DIFF_DEFAULT_MAX_CHARS=0

# Max model output tokens for build_app_agent_v3. Default is 4000 when unset or invalid.
SANDBOX_AGENT_BUILD_APP_AGENT_V3_MAX_TOKENS=4000

# Enable optional think tool for build_app_agent_v3 (0/1).
SANDBOX_AGENT_BUILD_APP_AGENT_V3_THINK_TOOL=1

# Enable system info/time injection for build_app_agent_v3 (0/1).

# Repository context prompt budget for build_app_agent_v3.
# Total snapshot prompt budget defaults to 3000 tokens, split into:
# - code signatures/structure: 2000 tokens
# - directory tree: 1000 tokens
SANDBOX_AGENT_BUILD_APP_AGENT_V3_CONTEXT_MAX_TOKENS=3000
SANDBOX_AGENT_BUILD_APP_AGENT_V3_CONTEXT_SIGNATURE_MAX_TOKENS=2000
SANDBOX_AGENT_BUILD_APP_AGENT_V3_CONTEXT_TREE_MAX_TOKENS=1000
# Enable verbose repository-context debug prints when diagnosing container summary generation.
SANDBOX_AGENT_BUILD_APP_AGENT_V3_CONTEXT_DEBUG=0
# Disable tiktoken-based token counting for repository context (0/1).
# Use when the encoding download is blocked; falls back to heuristic counting.
SANDBOX_AGENT_BUILD_APP_AGENT_V3_CONTEXT_DISABLE_TIKTOKEN=0
