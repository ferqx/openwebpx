FROM alpine:3.20

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PATH="/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin:/root/.local/bin:/root/.npm-global/bin"

# Preinstall common tooling for coding-agent terminal workflows.
RUN apk add --no-cache \
    bash \
    build-base \
    ca-certificates \
    coreutils \
    curl \
    diffutils \
    fd \
    file \
    findutils \
    gawk \
    github-cli \
    git \
    git-lfs \
    glab \
    grep \
    jq \
    less \
    libffi-dev \
    make \
    nano \
    nodejs \
    npm \
    openssl-dev \
    openssh-client \
    patch \
    procps \
    py3-pip \
    python3 \
    python3-dev \
    ripgrep \
    rsync \
    sed \
    sqlite3 \
    tar \
    tree \
    tzdata \
    unzip \
    util-linux \
    vim \
    wget \
    xz \
    zip \
    && update-ca-certificates

# Ensure npm global packages are in PATH and install Node.js package managers
RUN npm config set prefix '/root/.npm-global' && \
    mkdir -p /root/.npm-global/bin && \
    mkdir -p /root/.local/bin && \
    echo "Installing Node.js package managers..." && \
    npm install -g pm2@latest && \
    npm install -g pnpm@latest yarn@latest && \
    npm install -g repomix@latest && \
    npm install -g corepack@latest && \
    corepack enable && \
    corepack prepare yarn@stable --activate && \
    corepack prepare pnpm@latest --activate

WORKDIR /workspace

RUN echo "Python: $(python3 --version)" && \
    echo "Node: $(node --version)" && \
    echo "NPM: $(npm --version)" && \
    echo "PNPM: $(pnpm --version)" && \
    echo "Yarn: $(yarn --version)" && \
    echo "PM2: $(pm2 --version)" && \
    echo "Git: $(git --version)" && \
    echo "rg: $(rg --version | head -1)" && \
    echo "GCC: $(gcc --version | head -1)" && \
    echo "SQLite: $(sqlite3 --version)" && \
    echo "OpenSSL: $(openssl version)"

CMD ["/bin/bash"]
