FROM alpine:3.20

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

# Preinstall common tooling for coding-agent terminal workflows.
RUN apk add --no-cache \
    bash \
    ca-certificates \
    coreutils \
    curl \
    diffutils \
    fd \
    file \
    findutils \
    gawk \
    git \
    git-lfs \
    grep \
    jq \
    less \
    make \
    nano \
    nodejs \
    npm \
    openssh-client \
    patch \
    procps \
    py3-pip \
    python3 \
    ripgrep \
    rsync \
    sed \
    tar \
    tree \
    tzdata \
    unzip \
    util-linux \
    vim \
    wget \
    xz \
    zip \
    && npm install -g pm2 \
    && npm install -g pnpm yarn \
    && update-ca-certificates

WORKDIR /workspace

RUN echo "Python: $(python3 --version)" && \
    echo "Node: $(node --version)" && \
    echo "NPM: $(npm --version)" && \
    echo "PNPM: $(pnpm --version)" && \
    echo "Yarn: $(yarn --version)" && \
    echo "PM2: $(pm2 --version)" && \
    echo "Git: $(git --version)" && \
    echo "rg: $(rg --version | head -1)"

CMD ["/bin/bash"]
