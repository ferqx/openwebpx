FROM alpine:latest

# 设置环境变量
ENV PYTHONUNBUFFERED=1

# 安装系统依赖
RUN apk add --no-cache \
    python3 \
    py3-pip \
    nodejs \
    npm \
    git \
    curl \
    && npm install -g pm2

# 创建应用目录
WORKDIR /app

# 验证安装
RUN echo "Python: $(python3 --version)" && \
    echo "Node: $(node --version)" && \
    echo "NPM: $(npm --version)" && \
    echo "PM2: $(pm2 --version)" && \
    echo "Git: $(git --version)"

# 设置默认命令
CMD ["/bin/sh"]
