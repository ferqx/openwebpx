FROM alpine:3.20

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    NPM_CONFIG_PREFIX=/usr/local \
    PATH="/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin"

# Pre-install base system dependencies
RUN apk add --no-cache \
    bash \
    build-base \
    ca-certificates \
    curl \
    git \
    jq \
    less \
    libffi-dev \
    make \
    nano \
    nodejs \
    npm \
    openssl-dev \
    openssh-client \
    patch \
    procps \
    py3-pip \
    python3 \
    python3-dev \
    ripgrep \
    rsync \
    sed \
    sqlite \
    tar \
    tree \
    tzdata \
    unzip \
    util-linux \
    vim \
    wget \
    xz \
    zip \
    && python3 -m pip install --break-system-packages --no-cache-dir \
       pytest \
       pytest-asyncio \
       pytest-cov \
       ruff \
       requests \
       pydantic \
       python-dotenv

# Fix Node.js environment: Direct physical installation instead of shims
# We set prefix to /usr/local so binaries go directly into PATH
RUN npm config set prefix /usr/local && \
    echo "Installing Node.js package managers..." && \
    npm install -g --force pnpm@latest yarn@latest pm2@latest repomix@latest && \
    # Double check and force symlinks if needed
    [ -f /usr/local/bin/pnpm ] || ln -s $(npm config get prefix)/bin/pnpm /usr/local/bin/pnpm && \
    pnpm --version && yarn --version

WORKDIR /workspace

# Verify all critical tools are in PATH
RUN echo "Final PATH: $PATH" && \
    echo "Python: $(python3 --version)" && \
    echo "Node: $(node --version)" && \
    echo "NPM: $(npm --version)" && \
    echo "PNPM: $(pnpm --version)" && \
    echo "Yarn: $(yarn --version)" && \
    echo "Ruff: $(ruff --version)" && \
    echo "Pytest: $(pytest --version)"

CMD ["/bin/bash"]
